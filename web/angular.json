{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "setup": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/setup",
      "sourceRoot": "projects/setup/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/setup/src/main.ts",
            "tsConfig": "projects/setup/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/setup/public"
              },
              {
                "glob": "*.ttf",
                "input": "shared/fonts",
                "output": "fonts"
              }
            ],
            "styles": [
              "shared/tokens.css",
              "shared/aurora.css",
              "projects/setup/src/styles.css"
            ],
            "outputPath": {
              "base": "../recorder/src/workdigest/setup/web",
              "browser": ""
            },
            "allowedCommonJsDependencies": [
              "qrcode-generator"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "400kB",
                  "maximumError": "800kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "setup:build:production"
            },
            "development": {
              "buildTarget": "setup:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [],
            "tsConfig": "projects/setup/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/setup/public"
              },
              {
                "glob": "*.ttf",
                "input": "shared/fonts",
                "output": "fonts"
              }
            ],
            "styles": [
              "shared/tokens.css",
              "shared/aurora.css",
              "projects/setup/src/styles.css"
            ],
            "karmaConfig": "karma.conf.cjs"
          }
        }
      }
    },
    "site": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/site",
      "sourceRoot": "projects/site/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/site/src/main.ts",
            "tsConfig": "projects/site/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/site/public"
              },
              {
                "glob": "*.ttf",
                "input": "shared/fonts",
                "output": "fonts"
              }
            ],
            "styles": [
              "shared/tokens.css",
              "shared/aurora.css",
              "projects/site/src/styles.css"
            ],
            "server": "projects/site/src/main.server.ts",
            "outputMode": "static",
            "outputPath": "dist/site",
            "allowedCommonJsDependencies": [
              "qrcode-generator"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "700kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "14kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "site:build:production"
            },
            "development": {
              "buildTarget": "site:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [],
            "tsConfig": "projects/site/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/site/public"
              },
              {
                "glob": "*.ttf",
                "input": "shared/fonts",
                "output": "fonts"
              }
            ],
            "styles": [
              "shared/tokens.css",
              "shared/aurora.css",
              "projects/site/src/styles.css"
            ],
            "karmaConfig": "karma.conf.cjs"
          }
        }
      }
    }
  }
}